# 复制为 .env 后修改；切勿提交真实密钥到 Git
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=mcp_gateway
MYSQL_USER=mcp_gateway
MYSQL_PASSWORD=change-me-db-password

# 32 字节 AES-256 密钥的 Base64；生成示例：
#   openssl rand -base64 32
MCP_SECURITY_SECRETKEY=

# 后台管理员 JWT 签名密钥，长度 >= 32；生成示例：
#   openssl rand -base64 48
MCP_ADMIN_JWT_SECRET=

# 首次启动初始超管密码（至少 8 位）
MCP_ADMIN_INIT_PASSWORD=

# 生产保持 false
MCP_SWAGGER_ENABLED=false
# 下游均为内网服务时才设为 true
MCP_SECURITY_ALLOW_PRIVATE_NETWORK=false
SPRING_PROFILES_ACTIVE=dev

# 下游内部断言（不是认证开关；认证只认 x-dsh-auth-token）
MCP_IDENTITY_ENABLED=false
# JWS = 网关只签名来源断言（pass-through 推荐）；JWE = 需要下游加密公钥
MCP_IDENTITY_TOKEN_FORMAT=JWS
# 是否把原始 x-dsh-auth-token 透传给下游 MCP Server（仅可信下游）
MCP_IDENTITY_FORWARD_USER_TOKEN=false
# 网关签名私钥（Base64 PKCS#8 或 PEM；生产必须固定配置）
MCP_IDENTITY_SIGNING_KEY=
MCP_IDENTITY_SIGNING_KID=gw-1
MCP_IDENTITY_USER_TOKEN_HEADER=x-dsh-auth-token

# 用户 token 认证（唯一认证方式；校验由 user-center 本地 UserTokenStore 提供）
MCP_AUTH_USER_TOKEN_HEADER=x-dsh-auth-token
MCP_AUTH_USER_TOKEN_CACHE_TTL_SECONDS=30

# discovery 返回给 DSH 的网关绝对地址
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8081

# 控制面 → 数据面的内部调用凭证（/internal/**）；两侧必须一致，空值时数据面只接受回环访问
MCP_INTERNAL_TOKEN=

# 多副本：会话 / 上游会话 / 变更事件走 Redis。单副本保持 false 即可
MCP_REDIS_ENABLED=false
MCP_REDIS_URI=redis://127.0.0.1:6379/0
