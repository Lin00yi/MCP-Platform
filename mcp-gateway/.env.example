# ============================================================
# 本地开发环境变量（复制为 .env）
#
# 只需要关心这一份；内部调参（分页/检索/分片/探活/熔断/embedding 模型等）
# 已经有安全默认值，不在 .env 里体现，详见 ../docs/配置说明.md。
# ============================================================

# ---------- 数据库（仅首次初始化 MySQL 时参考，两个 jar 只读 MCP_DB_*） ----------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=mcp_gateway
MYSQL_USER=mcp_gateway
MYSQL_PASSWORD=change-me-db-password
# 可选：本机 MySQL 端口/库名不同的时候覆盖 JDBC URL
# MCP_DB_URL=jdbc:mysql://127.0.0.1:3306/mcp_gateway?useSSL=false&serverTimezone=Asia/Shanghai

# ---------- 密钥（生产必须显式配置） ----------
# 32 字节 AES-256 密钥的 Base64：openssl rand -base64 32
MCP_SECURITY_SECRETKEY=
# 后台管理员 JWT 签名密钥，>= 32 字符：openssl rand -base64 48
MCP_ADMIN_JWT_SECRET=
# 后台登录有效期（小时）：默认 168 = 7 天；支持 1~168（低于 1 按 1 小时、超过按 7 天，非法值按 168）
MCP_ADMIN_JWT_TTL_HOURS=168
# 首次启动初始超管密码（>= 8 位，仅库中无管理员时生效）
MCP_ADMIN_INIT_PASSWORD=

# ---------- 运行 ----------
SPRING_PROFILES_ACTIVE=dev
# 生产保持 false；本地调试可 true
MCP_SWAGGER_ENABLED=false
# 下游都是内网时才设为 true（会放开 SSRF 防护）
MCP_SECURITY_ALLOW_PRIVATE_NETWORK=false

# discovery 返回给客户端的网关绝对地址
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8081
# 控制面 → 数据面内部接口凭证；两侧必须一致
MCP_INTERNAL_TOKEN=

# ---------- 用户认证 ----------
# 只认 x-dsh-auth-token；生产由 user-center 提供 UserTokenStore
# 仅本地/E2E 可用静态 token（生产会启动失败）：
# MCP_AUTH_STATIC_TOKENS=e2e-token|u-e2e|E2E 用户|C-E2E|tool:read,tool:write

# ---------- 身份下传 ----------
MCP_IDENTITY_ENABLED=false
# OFF / OPTIONAL（失败降级）/ REQUIRED（失败拒绝 -32003）
MCP_IDENTITY_MODE=OPTIONAL
# JWS = 只签名；JWE = 需要下游公钥
MCP_IDENTITY_TOKEN_FORMAT=JWS
# 仅可信下游才开启原始用户 token 透传
MCP_IDENTITY_FORWARD_USER_TOKEN=false
# 生产必须固定配置；Base64 PKCS#8 或 PEM
MCP_IDENTITY_SIGNING_KEY=

# ---------- 多副本 ----------
# 单副本 false；多副本 true
MCP_REDIS_ENABLED=false
MCP_REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 工具治理（可选档位） ----------
# default / compact（小上下文）/ large（大工具量）
MCP_TOOLS_PROFILE=default
# 应急回退：false 时所有 Server 按 DIRECT
MCP_TOOLS_META_ENABLED=true
# memory / redis（多副本建议 redis）
MCP_TOOLS_CHUNK_STORE=memory

# ---------- Embedding（可选） ----------
# 不配置 host/key 时自动降级词法检索
# MCP_EMBEDDING_HOST=
# MCP_EMBEDDING_KEY=
